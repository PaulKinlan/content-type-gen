{
  "imports": {
    "std/": "https://deno.land/std@0.224.0/"
  },
  "tasks": {
    "serve": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env server.ts",
    "pregenerate": "deno run --allow-read --allow-write scripts/generate.ts",
    "samples": "bash scripts/make-samples.sh",
    "check": "deno fmt --check && deno lint && deno check server.ts lib/*.ts scripts/generate.ts"
  }
}